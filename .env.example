# String de conexao do Postgres usado pelo Payload CMS.
# Formato: postgres://usuario:senha@host:porta/banco
# Em desenvolvimento: postgres://payload:payloadpw@localhost:5432/oncourt
DATABASE_URI=postgres://usuario:senha@localhost:5432/oncourt

# Chave usada pelo Payload para assinar os cookies de sessao do painel (/admin).
# Use um valor longo e aleatorio em producao, por exemplo: openssl rand -hex 32
PAYLOAD_SECRET=troque-esta-chave-secreta

# Segredo da rota de revalidacao manual (POST /api/revalidate?secret=...).
# O Payload ja limpa o cache sozinho pelos hooks das colecoes; esta rota serve
# para purgar as tags 'payload-content' e 'payload-settings' de fora, por
# exemplo depois de uma alteracao feita direto no banco.
REVALIDATE_SECRET=troque-este-segredo-de-revalidacao

# Token de leitura/escrita do Vercel Blob, usado pelo Payload para guardar os
# uploads da colecao 'media'. O valor e criado pela Vercel ao conectar um Blob
# Store ao projeto (Storage > Blob) e injetado automaticamente no deploy.
# Sem este token o plugin fica desativado e os uploads caem no disco local
# (public/media), que serve para desenvolvimento mas NAO persiste na Vercel.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx
